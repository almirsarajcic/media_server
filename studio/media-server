def mdns_services(config):
    """Advertise local aliases through macOS Bonjour, under the same supervisor."""
    if not config.get("enabled", False):
        return {}
    address = subprocess.run(["/usr/sbin/ipconfig", "getifaddr", config["interface"]],
                             capture_output=True, text=True, timeout=5)
    if address.returncode:
        return {}  # Network can recover independently of mounted media.
    try:
        ipv4 = str(ipaddress.IPv4Address(address.stdout.strip()))
    except ipaddress.AddressValueError:
        return {}
    return {"mdns-" + name: {"command": ["/usr/bin/dns-sd", "-P",
            "Studio " + name, "_http._tcp", "local.", str(80 if proxy_services() else port), name + ".local", ipv4]}
            for name, port in MDNS_PORTS.items()}


def supervise():
    ROOT.mkdir(parents=True, exist_ok=True)
    (ROOT / "logs").mkdir(exist_ok=True)
    lock = (ROOT / "state/supervisor.lock").open("w")
    try:
        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except BlockingIOError:
        raise RuntimeError("The media supervisor is already running")
    lock.write(str(os.getpid())); lock.flush()
    children = {}
    stopping = False
    last_message = None
    restart_after = {}
    last_health = 0
    endpoints = {}
    def stop_signal(_signum, _frame):
        nonlocal stopping
        stopping = True
    signal.signal(signal.SIGTERM, stop_signal)
    signal.signal(signal.SIGINT, stop_signal)
    try:
        while not stopping:
            try:
                if (ROOT / 'state/maintenance').exists():
                    raise RuntimeError('Intentional maintenance stop')
                profile = json.loads((ROOT / "state/storage.json").read_text())
                storage_check(profile, mount=True)
                services = json.loads((ROOT / "state/services.json").read_text())
                if not services:
                    raise RuntimeError("No native media applications are configured")
                app_names = set(services)
                if profile['mode'] == 'external':
                    services['settings-backup'] = {'command': [PYTHON, str(SCRIPT), 'backup-loop']}
                services.update(proxy_services())
                mdns_path = ROOT / "state/mdns.json"
                if mdns_path.exists():
                    services.update(mdns_services(json.loads(mdns_path.read_text())))
                for name in list(children):
                    proc, signature = children[name]
                    expected = json.dumps(services.get(name), sort_keys=True)
                    if name not in services or signature != expected:
                        subset = {name: children.pop(name)}; stop_children(subset)
                    elif proc.poll() is not None:
                        with contextlib.suppress(ProcessLookupError):
                            os.killpg(proc.pid, signal.SIGKILL)
                        children.pop(name)
                        restart_after[name] = time.monotonic() + 30
                        print(name + " exited; retrying after 30 seconds", flush=True)
                for name, settings in services.items():
                    if name in children or time.monotonic() < restart_after.get(name, 0):
                        continue
                    # Check immediately before each start, including process-crash recovery.
                    storage_check(profile)
                    environment = os.environ.copy()
                    environment.update(settings.get("environment", {}))
                    with (ROOT / "logs" / (name + ".stdout.log")).open("ab") as out, \
                         (ROOT / "logs" / (name + ".stderr.log")).open("ab") as err:
                        proc = subprocess.Popen(settings["command"], cwd=settings.get("cwd", ROOT),
                                                env=environment, stdout=out, stderr=err,
                                                start_new_session=True)
                    children[name] = (proc, json.dumps(settings, sort_keys=True))
                    print("Started " + name + " after storage verification", flush=True)
                if time.monotonic() - last_health >= 30:
                    endpoints = health()
                    rotate_logs()
                    last_health = time.monotonic()
                ready = len(children.keys() & app_names) == len(app_names) and all(endpoints.get(n, False) for n in app_names)
                message = "Native media stack " + ('healthy' if ready else 'starting or degraded') + " on verified " + profile["mode"] + " storage"
                state = {"phase": "running" if ready else "degraded", "endpoints": endpoints, "storage_mode": profile["mode"],
                         "supervisor_pid": os.getpid(), "apps": {n: p.pid for n, (p, _) in children.items() if n in app_names},
                         "mdns": {n.removeprefix("mdns-"): p.pid for n, (p, _) in children.items()
                                  if n.startswith("mdns-")},
                         "proxy": {n: p.pid for n, (p, _) in children.items() if n.startswith("proxy-")},
                         "workers": {n: p.pid for n, (p, _) in children.items() if n == "settings-backup"}}
            except (RuntimeError, OSError, ValueError, KeyError, subprocess.TimeoutExpired) as exc:
                stop_children(children)
                message = "Media startup blocked: " + str(exc)
                state = {"phase": "maintenance" if (ROOT / 'state/maintenance').exists() else "blocked", "reason": str(exc), "supervisor_pid": os.getpid(), "apps": {}}
            if message != last_message:
                print(message, flush=True); last_message = message
            state["checked_at"] = time.time()
            save_json(ROOT / "state/status.json", state)
            # Re-check mount loss frequently; successful recovery needs no manual action.
            for _ in range(5):
                if stopping: break
                time.sleep(1)
    finally:
        stop_children(children)
        save_json(ROOT / "state/status.json", {"phase": "stopped", "apps": {}, "checked_at": time.time()})
        lock.close()


