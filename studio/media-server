def download_native_packages():
    import concurrent.futures,hashlib,json,math,pathlib,subprocess,time,urllib.request,urllib.parse
    R=ROOT / "installers"
    packages={
     "sonarr.zip":("https://services.sonarr.tv/v1/download/main/latest?version=4&os=osx&arch=arm64&runtime=netcore&installer=true",64661024),
     "radarr.zip":("https://radarr.servarr.com/v1/update/master/updatefile?os=osx&runtime=netcore&arch=arm64&installer=true",66635503),
     "jackett.tar.gz":("https://github.com/Jackett/Jackett/releases/download/v0.24.2850/Jackett.Binaries.macOSARM64.tar.gz",47881503),
     "bazarr.zip":("https://github.com/morpheus65535/bazarr/releases/download/v1.6.2/bazarr.zip",31023716)}
    def package(item):
     name,(url,expected_size)=item;dest=R/name
     if dest.exists():return
     metadata=urllib.request.urlopen(urllib.request.Request(url,headers={"Range":"bytes=0-0"}),timeout=60)
     cr=metadata.headers.get("Content-Range","")
     if not cr.startswith("bytes 0-0/"):raise RuntimeError("Range request unsupported: "+name)
     size=int(cr.rsplit("/",1)[1]);etag=metadata.headers.get("ETag");effective=metadata.geturl();metadata.close()
     if expected_size and size!=expected_size:raise RuntimeError("Package size changed: "+name)
     parts=R/(name+"-parts");parts.mkdir(exist_ok=True)
     manifest=parts/"manifest.json"
     fresh={"url":url,"size":size,"etag":etag,"offset":(R/(name+".part")).stat().st_size if (R/(name+".part")).exists() else 0}
     if manifest.exists():
      old=json.loads(manifest.read_text())
      if any(old.get(k)!=fresh[k] for k in ["url","size","etag"]):raise RuntimeError("Download identity changed: "+name)
     else:manifest.write_text(json.dumps(fresh,indent=2))
     prefix=R/(name+".part")
     offset=json.loads(manifest.read_text()).get("offset",prefix.stat().st_size if prefix.exists() else 0)
     count=8;chunk=math.ceil((size-offset)/count)
     def fetch(i):
      start=offset+i*chunk;end=min(size-1,start+chunk-1);p=parts/str(i)
      if start>end:return
      if p.exists() and p.stat().st_size==end-start+1:return
      for attempt in range(3):
       done=p.stat().st_size if p.exists() else 0
       if done>end-start+1:raise RuntimeError("Oversize chunk: "+name)
       temp=parts/(str(i)+".new")
       args=["curl","--fail","--location","--silent","--show-error","--connect-timeout","30","--range",str(start+done)+"-"+str(end),"--output",str(temp),url]
       if etag:args[1:1]=["--header","If-Range: "+etag]
       result=subprocess.run(args,capture_output=True)
       if temp.exists():
        with p.open("ab") as out,temp.open("rb") as src:
         while data:=src.read(1024*1024):out.write(data)
        temp.unlink()
       if p.exists() and p.stat().st_size==end-start+1:return
       if p.exists() and p.stat().st_size>end-start+1:raise RuntimeError("Server ignored range: "+name)
       time.sleep(2)
      raise RuntimeError("Incomplete download: "+name)
     with concurrent.futures.ThreadPoolExecutor(max_workers=count) as pool:list(pool.map(fetch,range(count)))
     merged=R/(name+".merging")
     with merged.open("wb") as out:
      sources=([prefix] if offset else [])+[parts/str(i) for i in range(count) if (parts/str(i)).exists()]
      for p in sources:
       with p.open("rb") as src:
        while data:=src.read(1024*1024):out.write(data)
     assert merged.stat().st_size==size
     merged.rename(dest);print("Downloaded",name,size,flush=True)
    with concurrent.futures.ThreadPoolExecutor(max_workers=3) as pool:
     for future in concurrent.futures.as_completed([pool.submit(package,i) for i in packages.items()]):
      try:future.result()
      except Exception as exc:raise RuntimeError("Native package download failed") from exc


def stage_native_apps():
    import hashlib, json, pathlib, subprocess, tempfile, zipfile
    R=ROOT
    A=pathlib.Path.home()/"Applications"
    A.mkdir(exist_ok=True)
    expected={"jellyfin.dmg":"f6a4d13c1783667bc9c6c6de1bcec5d8c9537e5143ba44cda899cdf1cff83bc3"}
    for name in ["jellyfin.dmg","sonarr.zip","radarr.zip","jackett.tar.gz","bazarr.zip"]:
     p=R/"installers"/name
     receipt=R/"checks"/(name+".installed.json")
     if not p.exists() or receipt.exists():continue
     h=hashlib.file_digest(open(p,"rb"),"sha256").hexdigest()
     if name in expected and h!=expected[name]:raise RuntimeError("Package hash mismatch: "+name)
     if name.endswith(".dmg"):
      with tempfile.TemporaryDirectory(prefix="media-server-mount-") as m:
       subprocess.run(["hdiutil","attach","-nobrowse","-readonly","-mountpoint",m,str(p)],check=True,stdout=subprocess.DEVNULL)
       try:
        apps=list(pathlib.Path(m).glob("*.app"))
        assert len(apps)==1
        subprocess.run(["ditto",str(apps[0]),str(A/apps[0].name)],check=True)
       finally:subprocess.run(["hdiutil","detach",m],check=True,stdout=subprocess.DEVNULL)
     elif name in ["sonarr.zip","radarr.zip"]:
      subprocess.run(["ditto","-x","-k",str(p),str(A)],check=True)
     elif name=="jackett.tar.gz":
      subprocess.run(["tar","-xzf",str(p),"-C",str(R/"apps")],check=True)
     else:
      (R/"apps/bazarr").mkdir(exist_ok=True)
      with zipfile.ZipFile(p) as z:z.extractall(R/"apps/bazarr")
     receipt.write_text(json.dumps({"package":name,"sha256":h},indent=2))
     print("Staged",name,flush=True)


