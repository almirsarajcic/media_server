    if dest.exists():return
    parts=R/"jellyfin-parts";parts.mkdir(exist_ok=True)
    count=12;chunk=math.ceil(size/count)
    def fetch(i):
     start=i*chunk;end=min(size-1,start+chunk-1);p=parts/str(i)
     if p.exists() and p.stat().st_size==end-start+1:return
     for attempt in range(3):
      done=p.stat().st_size if p.exists() else 0
      if done>end-start+1:p.unlink();done=0
      temp=parts/(str(i)+".new")
      proc=subprocess.run(["curl","--fail","--silent","--show-error","--connect-timeout","20","--range",str(start+done)+"-"+str(end),"--output",str(temp),url],capture_output=True)
      if temp.exists():
       with p.open("ab") as out,temp.open("rb") as src:out.write(src.read())
       temp.unlink()
      if p.stat().st_size==end-start+1:
       print("Completed chunk",i+1,"of",count,flush=True);return
      if p.stat().st_size>end-start+1:raise RuntimeError("Server ignored download range")
