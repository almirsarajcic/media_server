    elif args.command == 'acquisition':
        activate_acquisition()
    elif args.command == 'prepare-boot':
        prepare_boot()
    elif args.command == 'backup':
        backup_state(force=True)
    elif args.command == 'backup-loop':
        backup_loop()
    elif args.command == 'test-recovery':
        test_recovery()
    elif args.command == "proxy":
        configure_proxy(enabled=not args.disable)
    elif args.command == "mdns":
        config = {"enabled": not args.disable, "interface": args.interface}
