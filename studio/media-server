def install_startup():
    import pwd
    import shutil
    if not DAEMON_PLIST.exists():
        raise RuntimeError('System boot service is not installed; run prepare-boot and its administrator installer first')
    job = plistlib.loads(DAEMON_PLIST.read_bytes())
    expected = {'Label': LABEL, 'ProgramArguments': [PYTHON, str(SCRIPT), 'run'],
                'WorkingDirectory': str(ROOT), 'UserName': pwd.getpwuid(os.getuid()).pw_name}
    if expected['UserName'] == 'root' or any(job.get(key) != value for key, value in expected.items()) or 'LimitLoadToSessionType' in job:
        raise RuntimeError('System boot job does not match this runtime/owner; reinstall the prepared boot job')
    SCRIPT.parent.mkdir(parents=True, exist_ok=True)
    if pathlib.Path(__file__).resolve() != SCRIPT.resolve():
        candidate = SCRIPT.with_name(SCRIPT.name + '.next')
        shutil.copyfile(pathlib.Path(__file__).resolve(), candidate)
        candidate.chmod(0o755)
        candidate.replace(SCRIPT)
    SCRIPT.chmod(0o755)
    loaded = launchctl('print', 'system/' + LABEL, capture_output=True, text=True)
    if loaded.returncode:
        launchctl('bootstrap', 'system', str(DAEMON_PLIST), check=True)
        loaded = launchctl('print', 'system/' + LABEL, capture_output=True, text=True)
    if loaded.returncode or str(SCRIPT) not in {line.strip() for line in loaded.stdout.splitlines()}:
        raise RuntimeError('Loaded system boot job does not run this controller; maintenance remains enabled')
    (ROOT / 'state/maintenance').unlink(missing_ok=True)
    print('System media supervisor active')


def require_stopped():
    """Never replace installed applications while the owned stack is live."""
    if launchctl('print', 'system/' + LABEL, capture_output=True).returncode:
        return
    path = ROOT / 'state/status.json'
    state = json.loads(path.read_text()) if path.exists() else {}
    if not (ROOT / 'state/maintenance').exists() or state.get('phase') != 'maintenance' or state.get('apps') or time.time() - state.get('checked_at', 0) > 15:
        raise RuntimeError('Stop the media stack and require fresh maintenance status before changing installed applications')


def require_rebuild_state():
    """Rebuild dependencies around restored state; never invent replacement accounts."""
    required = ('access.json', 'jellyfin-auth.json', 'sonarr/config.xml', 'sonarr/sonarr.db',
                'radarr/config.xml', 'radarr/radarr.db', 'bazarr/config/config.yaml', 'bazarr/db/bazarr.db',
