        result['torrent_payloads_missing'] = sum(item['state'] == 'missingFiles' for item in protected)
    auth = json.loads((ROOT / "state/jellyfin-auth.json").read_text())
    headers = {"Authorization": 'MediaBrowser Token="' + auth["token"] + '", Client="Media Server Verification", '
               'Device="Mac Studio", DeviceId="media-server-check", Version="1.0"'}
    base = "http://127.0.0.1:8096"
    def get(url):
        with urllib.request.urlopen(urllib.request.Request(url, headers=headers), timeout=90) as response:
            return response.read()
    deadline = time.monotonic() + 120
    movies = []
    while not movies and time.monotonic() < deadline:
        data = json.loads(get(base + "/Items?Recursive=true&IncludeItemTypes=Movie&Fields=MediaSources&userId=" + auth["user_id"]))
        movies = [i for i in data["Items"] if i.get("MediaSources") and pathlib.Path(i["MediaSources"][0].get("Path", "")).is_file()]
        if not movies: time.sleep(2)
    if not movies: raise RuntimeError("Jellyfin library scan has not produced playable movies")
    movie = movies[0]
    source = movie["MediaSources"][0]
    session = uuid.uuid4().hex
    query = urllib.parse.urlencode({"MediaSourceId": source["Id"], "DeviceId": "media-server-check",
        "PlaySessionId": session, "VideoCodec": "h264", "AudioCodec": "aac", "VideoBitrate": 1500000,
        "AudioBitrate": 128000, "MaxWidth": 1280, "MaxHeight": 720, "EnableAutoStreamCopy": "false",
        "AllowVideoStreamCopy": "false", "SubtitleStreamIndex": -1, "TranscodingMaxAudioChannels": 2,
        "SegmentContainer": "ts", "MinSegments": 1, "BreakOnNonKeyFrames": "true"})
    master_url = base + "/Videos/" + movie["Id"] + "/master.m3u8?" + query
    playback_started = time.time()
    try:
        master = get(master_url).decode()
        playlist_url = urllib.parse.urljoin(master_url, next(l for l in master.splitlines() if l and not l.startswith("#")))
        playlist = get(playlist_url).decode()
        segment_url = urllib.parse.urljoin(playlist_url, next(l for l in playlist.splitlines() if l and not l.startswith("#")))
        segment = get(segment_url)
        target = ROOT / "checks/hardware-transcode-segment.ts"; target.write_bytes(segment)
        ffprobe = pathlib.Path.home() / "Applications/Jellyfin.app/Contents/MacOS/ffprobe"
        streams = json.loads(subprocess.check_output([str(ffprobe), "-v", "error", "-show_entries",
            "stream=codec_type,codec_name,width,height", "-of", "json", str(target)]))["streams"]
        logs = list((ROOT / "logs/jellyfin").glob("*FFmpeg*")) + list((ROOT / "logs/jellyfin").glob("*ffmpeg*"))
        logs = [p for p in logs if p.stat().st_mtime >= playback_started
                and source["Path"] in p.read_text(errors="replace")]
        if not logs: raise RuntimeError("No FFmpeg log matched this verification playback")
        log = max(logs, key=lambda p: p.stat().st_mtime)
        text = log.read_text(errors="replace")
        if "-hwaccel videotoolbox" not in text or "h264_videotoolbox" not in text:
            raise RuntimeError("Playback did not demonstrate Apple hardware decode/encode")
        if not any(s.get("codec_name") == "h264" and s.get("height") == 720 for s in streams):
            raise RuntimeError("Hardware transcode segment is not playable 720p H.264")
        result.update(source_movie=movie["Name"], target_streams=streams, segment_bytes=len(segment),
                      hardware_decode=True, hardware_encode=True, ffmpeg_log=str(log))
    finally:
        stop = base + "/Videos/ActiveEncodings?" + urllib.parse.urlencode({"deviceId": "media-server-check", "playSessionId": session})
        with contextlib.suppress(Exception):
            urllib.request.urlopen(urllib.request.Request(stop, method="DELETE", headers=headers), timeout=20).close()
    result["verified_at"] = time.time()
    save_json(ROOT / ("checks/native-" + profile["mode"] + "-verification.json"), result)
    print("Native interfaces verified; Apple hardware transcode produced playable 720p H.264/AAC")


