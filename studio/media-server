        actual = subprocess.check_output(['git', '-C', str(source), 'rev-parse', 'HEAD'], text=True).strip()
        if actual != commit:
            raise RuntimeError('Headless source revision differs from pinned upstream release')
        subprocess.run(['/opt/homebrew/bin/cmake', '-S', str(source), '-B', str(source / 'build'), '-G', 'Ninja',
                        '-DCMAKE_MAKE_PROGRAM=/opt/homebrew/bin/ninja', '-DCMAKE_BUILD_TYPE=Release',
                        '-DGUI=OFF', '-DWEBUI=ON', '-DCMAKE_OSX_ARCHITECTURES=arm64',
