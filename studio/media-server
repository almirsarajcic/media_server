def lifecycle_path():
    return ROOT / 'state/lifecycle.json'


def load_lifecycle():
    path = lifecycle_path()
    if not path.exists():
        return {'service_stops': [], 'media_stops': [], 'operation': None,
                'last_result': None}
    state = json.loads(path.read_text())
    if not isinstance(state, dict):
        raise RuntimeError('Lifecycle state is invalid; inspect private state before retrying')
    state.setdefault('service_stops', [])
    state.setdefault('media_stops', [])
    state.setdefault('operation', None)
    state.setdefault('last_result', None)
    return state


def service_held(name, lifecycle):
    return name in lifecycle.get('service_stops', []) or name in lifecycle.get('media_stops', [])


def apply_control_intent(lifecycle, service, action, configured):
    """Persist only requested intent; return the services this operation must affect."""
    configured = [name for name in MEDIA_SERVICE_IDS if name in configured]
    explicit = set(lifecycle.get('service_stops', []))
    grouped = set(lifecycle.get('media_stops', []))
    if service != 'media' and service not in configured:
        raise RuntimeError('Requested media service is not configured: ' + service)
    if service == 'media':
        if action == 'stop':
            grouped |= set(configured) - explicit
            stop_targets, start_targets = configured, []
        elif action == 'start':
            grouped.clear()
            stop_targets = []
            start_targets = [name for name in configured if name not in explicit]
        else:
            stop_targets = start_targets = [name for name in configured if name not in explicit and name not in grouped]
    elif action == 'stop':
        explicit.add(service)
        stop_targets, start_targets = [service], []
    elif action == 'start':
        explicit.discard(service)
        grouped.discard(service)
        stop_targets, start_targets = [], [service]
    else:
        explicit.discard(service)
        grouped.discard(service)
        stop_targets = start_targets = [service]
    lifecycle['service_stops'] = sorted(explicit)
    lifecycle['media_stops'] = sorted(grouped)
    return stop_targets, start_targets


def is_storage_gate_failure(error):
    if isinstance(error, (OSError, subprocess.TimeoutExpired)):
        return True
    message = str(error)
    return message.startswith((
        'A registered external storage profile', 'Expected media volume',
        'Media volume UUID', 'External storage profile', 'Media root is outside',
        'Stable application media path', 'Media storage marker',
        'Required media directory', 'Media directory points outside',
        'Media filesystem verification',
    ))


def operation_guard(shared=False, nonblocking=True):
    """Lock shared with backup writers and exclusive to lifecycle operations."""
    path = ROOT / 'state/control-operation.lock'
    path.parent.mkdir(parents=True, exist_ok=True)
    handle = path.open('a')
    os.fchmod(handle.fileno(), 0o600)
    flags = fcntl.LOCK_SH if shared else fcntl.LOCK_EX
    if nonblocking:
        flags |= fcntl.LOCK_NB
    try:
        fcntl.flock(handle.fileno(), flags)
    except BlockingIOError:
        handle.close()
        return None
    return handle


def release_operation_guard(handle):
    if handle is not None:
        with contextlib.suppress(OSError, ValueError):
            fcntl.flock(handle.fileno(), fcntl.LOCK_UN)
        with contextlib.suppress(OSError, ValueError):
            handle.close()


def backup_guard():
    handle = operation_guard(shared=True)
    if handle is None:
        raise RuntimeError('A media lifecycle operation is in progress; retry the backup after it completes')
    try:
        operation = load_lifecycle().get('operation')
        if operation and operation.get('status') == 'pending':
            raise RuntimeError('A pending media lifecycle operation needs recovery before backup')
    except Exception:
        release_operation_guard(handle)
        raise
    return handle


def job_domain():
