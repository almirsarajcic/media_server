def launchctl(*args, **kwargs):
    prefix = ['sudo', '-n'] if args[0] in ('bootstrap', 'bootout') and args[1].startswith('system') else []
    return subprocess.run(prefix + ['/bin/launchctl', *args], **kwargs)


def health():
    import urllib.request
    import urllib.error
    import http.cookiejar
    result = {}
    ports = dict(MDNS_PORTS)
    if 'flaresolverr' in json.loads((ROOT / 'state/services.json').read_text()):
        ports['flaresolverr'] = 8191
    for name, port in ports.items():
        try:
            opener = urllib.request.build_opener(urllib.request.HTTPCookieProcessor(http.cookiejar.CookieJar()))
            with opener.open('http://127.0.0.1:' + str(port) + '/', timeout=2) as response:
                result[name] = response.status < 500
        except urllib.error.HTTPError as error:
            result[name] = error.code in (401, 403)
        except (OSError, urllib.error.URLError):
            result[name] = False
    return result


def service_health(name, timeout=1.0):
    """Probe one app endpoint without exposing credentials or changing its state."""
    import urllib.error
    import urllib.request
    port = SERVICE_PORTS.get(name)
    if port is None:
        return False
    try:
        with urllib.request.urlopen('http://127.0.0.1:' + str(port) + '/', timeout=timeout) as response:
            return response.status < 500
    except urllib.error.HTTPError as error:
        return error.code in (401, 403)
    except (OSError, urllib.error.URLError):
        return False


def active_arr_commands(app):
    """Read the configured Arr API and report imports/commands without exposing its key."""
    import urllib.request
    import urllib.parse
    import xml.etree.ElementTree as ET
    ports = {'sonarr': 8989, 'radarr': 7878}
    if app not in ports:
        return []
    try:
        key = ET.parse(ROOT / 'state' / app / 'config.xml').findtext('ApiKey')
        if not key:
            raise RuntimeError('API key is missing')
        base = 'http://127.0.0.1:' + str(ports[app]) + '/api/v3/'
        def get(path):
            request = urllib.request.Request(base + path, headers={'X-Api-Key': key})
            with urllib.request.urlopen(request, timeout=5) as response:
                return json.loads(response.read())
        commands = get('command')
        if not isinstance(commands, list):
            raise RuntimeError('Command response is invalid')
        active = []
        for command in commands:
            if not isinstance(command, dict) or not isinstance(command.get('status'), str):
                raise RuntimeError('Command response is incomplete')
            status = command['status'].lower()
            if status in {'queued', 'started', 'running', 'delayed', 'pending', 'waiting'}:
                active.append({'name': str(command.get('name', 'unknown')),
                               'status': status, 'id': command.get('id')})
        # Arr reports download import activity separately from its command queue.
        page = 1
        while True:
            query = urllib.parse.urlencode({'page': page, 'pageSize': 100,
                                            'includeUnknownMovieItems': 'true'})
            queue = get('queue?' + query)
            if not isinstance(queue, dict) or not isinstance(queue.get('records'), list):
                raise RuntimeError('Queue response is invalid')
            records = queue['records']
            for item in records:
                if not isinstance(item, dict):
                    raise RuntimeError('Queue response is incomplete')
                state = str(item.get('trackedDownloadState', item.get('status', ''))).lower()
                if state in {'importpending', 'importing', 'importpendingfailed'}:
                    active.append({'name': 'Download import', 'status': state,
                                   'id': item.get('id')})
            total = queue.get('totalRecords', len(records))
            if not isinstance(total, int) or len(records) < 100 or page * 100 >= total:
                break
            page += 1
        return active
    except RuntimeError:
        raise
    except Exception as error:
        # Fail closed: an unreadable Arr queue is not evidence that shutdown is safe.
        raise RuntimeError(app.capitalize() + ' active commands could not be checked') from error


def require_arr_idle(targets, children=None):
    for app in ('sonarr', 'radarr'):
        if app not in targets:
            continue
        # A down/held Arr instance has no live command queue to inspect. If it
        # is still owned or answering, require its private API to confirm idle.
        if not ((children and app in children) or service_health(app)):
            continue
        active = active_arr_commands(app)
        if active:
            raise RuntimeError(app.capitalize() + ' has active command(s); wait for imports and commands to finish')


def rotate_logs():
    # Copy/truncate keeps the descriptors held by launchd and child apps valid.
    import shutil
    for path in (ROOT / 'logs').glob('*.log'):
        if path.stat().st_size < 10 * 1024 * 1024:
            continue
        for n in (2, 1):
            old = pathlib.Path(str(path) + '.' + str(n))
            if old.exists(): old.replace(pathlib.Path(str(path) + '.' + str(n + 1)))
        shutil.copyfile(path, str(path) + '.1')
        with path.open('r+b') as stream: stream.truncate(0)


def backup_state(force=False):
    """Allow one settings snapshot writer at a time, including manual backups."""
    guard = backup_guard()
    try:
        with (ROOT / 'state/backup.lock').open('a') as lock:
            os.fchmod(lock.fileno(), 0o600)
            try:
                fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
            except BlockingIOError as error:
                raise RuntimeError('Settings backup already in progress; retry after it finishes') from error
            return _backup_state(force)
    finally:
        release_operation_guard(guard)


def _backup_state(force=False):
    """SQLite online snapshots plus private settings; exclude regenerable data."""
    import shutil
    import sqlite3
    profile = json.loads((ROOT / 'state/storage.json').read_text())
    storage_check(profile)
    if profile['mode'] != 'external':
        raise RuntimeError('Backups require the registered external volume')
    base = pathlib.Path(profile['mountpoint']) / 'media-server-backups'
    base.mkdir(mode=0o700, exist_ok=True)
    base.chmod(0o700)
    date = time.strftime('%Y-%m-%dT%H%M%S' if force else '%Y-%m-%d')
    snapshots = [(json.loads((p / 'complete.json').read_text())['created_at'], p)
                 for p in base.iterdir() if p.is_dir() and (p / 'complete.json').is_file()]
    if not force and any(time.strftime('%Y-%m-%d', time.localtime(created)) == date
                         for created, _ in snapshots):
        return
    destination = base / date
    if (destination / 'complete.json').exists(): return
    partial = base / (date + '.partial')
    if partial.exists():
        shutil.rmtree(partial)
    partial.mkdir(mode=0o700, exist_ok=True)
    count = 0
    for source in (ROOT / 'state').rglob('*'):
        relative = source.relative_to(ROOT / 'state')
        if source.is_symlink() or not source.is_file(): continue
        if any(p.lower() in ('cache', 'logs', 'metadata', 'mediacover', 'transcodes', 'backups', 'caddy-data', 'caddy-config') for p in relative.parts): continue
        if source.name.endswith(('-wal', '-shm', '.lock', '.new')) or source.name in (
                'status.json', 'supervisor.lock', 'control-request.json', 'control-inflight.json'):
            continue
        storage_check(profile)
        target = partial / 'state' / relative
        target.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
        with source.open('rb') as stream: sqlite = stream.read(16) == b'SQLite format 3\x00'
        if sqlite:
            with contextlib.closing(sqlite3.connect('file:' + str(source) + '?mode=ro', uri=True, timeout=10)) as original, contextlib.closing(sqlite3.connect(target)) as copy, copy:
                original.backup(copy)
                if copy.execute('pragma quick_check').fetchone()[0] != 'ok':
                    raise RuntimeError('Backup SQLite check failed: ' + str(relative))
        else:
            shutil.copyfile(source, target)
        target.chmod(0o600)
        count += 1
    # These receipts prevent a restore from re-importing deleted torrents or
    # overwriting newer transfer preferences. They are part of recoverable state.
    for name in ('config-import.json', 'removed-torrents.json', 'download-preferences-import.json'):
        source = ROOT / 'checks' / name
        if source.exists():
            target = partial / 'checks' / name
            target.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
            shutil.copyfile(source, target)
            target.chmod(0o600)
            count += 1
    shutil.copyfile(SCRIPT, partial / 'media-server')
    save_json(partial / 'complete.json', {'files': count, 'created_at': time.time(),
              'database_consistency': 'individual SQLite online backups; not a cross-application transaction'}, private=True)
    partial.rename(destination)
    snapshots.append((json.loads((destination / 'complete.json').read_text())['created_at'], destination))
    for _, old in sorted(snapshots)[:-7]: shutil.rmtree(old)
    print('Verified native settings backup: ' + str(destination), flush=True)


def backup_loop():
    while True:
        delay = 3600
        try:
            backup_state()
        except Exception as error:
            print('Backup failed: ' + str(error), flush=True)
            if 'media lifecycle operation is in progress' in str(error):
                delay = 30
        time.sleep(delay)


def restore_original_logins():
    """Restore archived Arr user rows offline, without changing native API keys."""
    import sqlite3
    import xml.etree.ElementTree as ET
    profile = json.loads((ROOT / 'state/storage.json').read_text());storage_check(profile)
    status = json.loads((ROOT / 'state/status.json').read_text())
    if not (ROOT / 'state/maintenance').exists() or status.get('phase') != 'maintenance' or status.get('apps') or time.time() - status.get('checked_at', 0) > 10:
        raise RuntimeError('Confirmed maintenance is required to restore original logins')
    backup = ROOT / 'migration-backups' / ('login-repair-' + time.strftime('%Y%m%dT%H%M%S'))
    backup.mkdir(mode=0o700, parents=True)
    result = {'backup': str(backup), 'apps': {}, 'restored_at': time.time()}
    for app in ('sonarr', 'radarr'):
        original = pathlib.Path(profile['mountpoint']) / 'media_server' / app / (app + '.db')
        target = ROOT / 'state' / app / (app + '.db')
        with contextlib.closing(sqlite3.connect('file:' + str(original) + '?mode=ro', uri=True)) as old, contextlib.closing(sqlite3.connect(target)) as new:
            columns = [r[1] for r in old.execute('pragma table_info(Users)')]
            if columns != [r[1] for r in new.execute('pragma table_info(Users)')]:
                raise RuntimeError('Original user schema does not match ' + app)
            rows = old.execute('select * from Users').fetchall()
            if not rows or any(not row[columns.index('Password')] for row in rows):
                raise RuntimeError('Original authenticated user is missing from ' + app)
            saved = backup / (app + '.db')
            with contextlib.closing(sqlite3.connect(saved)) as copy: new.backup(copy)
            saved.chmod(0o600)
            with new:
                new.execute('delete from Users')
                new.executemany('insert into Users values (' + ','.join('?' for _ in columns) + ')', rows)
                if new.execute('select * from Users').fetchall() != rows:
                    raise RuntimeError('Original user readback failed for ' + app)
            result['apps'][app] = {'original_users_restored': len(rows), 'native_api_key_preserved': True}
        config = ROOT / 'state' / app / 'config.xml'
        tree = ET.parse(config)
        instance = tree.find('InstanceName')
        if instance is not None:
            instance.text = app.title();tree.write(config, encoding='utf-8', xml_declaration=True)
    save_json(ROOT / 'checks/original-logins-restored.json', result, private=True)
    print('Original Sonarr and Radarr login records restored; native API keys unchanged')


def install_solver():
    """Pinned upstream source with scoped native macOS headless adjustments."""
    source = ROOT / 'apps/FlareSolverr'
    commit = '93125d6ea6956906c8dfa29e169b2dc67d993dc3'
    if not source.exists():
        subprocess.run(['git', 'clone', '--depth', '1', '--branch', 'v3.5.2',
                        'https://github.com/FlareSolverr/FlareSolverr.git', str(source)], check=True)
    if subprocess.check_output(['git', '-C', str(source), 'rev-parse', 'HEAD']).decode().strip() != commit:
        raise RuntimeError('Unexpected FlareSolverr source revision')
    venv = ROOT / 'apps/flaresolverr-venv'
    if not (venv / 'bin/python').exists(): subprocess.run([PYTHON, '-m', 'venv', str(venv)], check=True)
    cached_selenium = ROOT / 'wheels/solver/selenium-4.47.0-py3-none-any.whl'
    if cached_selenium.exists():
        subprocess.run([str(venv / 'bin/python'), '-m', 'pip', 'install', '--no-deps', str(cached_selenium)], check=True)
    subprocess.run([str(venv / 'bin/python'), '-m', 'pip', 'install', '--find-links', str(ROOT / 'wheels/solver'), '-r', str(source / 'requirements.txt')], check=True)
    browser = ROOT / 'apps/flaresolverr-browser'
    chrome = browser / 'Google Chrome.app/Contents/MacOS/Google Chrome'
    driver = browser / 'chromedriver-mac-arm64/chromedriver'
    browser.mkdir(exist_ok=True)
    if not chrome.exists():
        installed = pathlib.Path('/Applications/Google Chrome.app')
        version = plistlib.loads((installed / 'Contents/Info.plist').read_bytes())['CFBundleShortVersionString']
        if version != '155.0.8059.40': raise RuntimeError('Qualify a matching managed browser/driver version before installation')
        subprocess.run(['/bin/cp', '-cR', str(installed), str(browser / 'Google Chrome.app')], check=True)
    if not driver.exists():
        archive = ROOT / 'installers/solver-chromedriver.zip'
        subprocess.run(['curl', '--fail', '--silent', '--show-error', '-C', '-', '-o', str(archive),
            'https://storage.googleapis.com/chrome-for-testing-public/155.0.8059.79/mac-arm64/chromedriver-mac-arm64.zip'], check=True)
        subprocess.run(['ditto', '-x', '-k', str(archive), str(browser)], check=True)
    # Upstream patches the driver binary. macOS requires a fresh signature after
    # that patch; otherwise the kernel kills the driver at launch with signal 9.
    env = dict(os.environ, PYTHONPATH=str(source / 'src'))
    subprocess.run([str(venv / 'bin/python'), '-c',
        'import sys; from undetected_chromedriver.patcher import Patcher; Patcher(executable_path=sys.argv[1]).auto()',
        str(driver)], env=env, check=True)
    subprocess.run(['codesign', '--force', '--sign', '-', str(driver)], check=True)
    subprocess.run(['codesign', '--verify', '--strict', str(driver)], check=True)
    # The upstream Linux/Xvfb branch cannot run in a macOS boot daemon.
    utils = source / 'src/utils.py'
    text = subprocess.check_output(['git', '-C', str(source), 'show', commit + ':src/utils.py']).decode()
    text = text.replace("if os.name == 'nt':\n            windows_headless = True",
                        "if os.name == 'nt' or platform.system() == 'Darwin':\n            windows_headless = True")
    text = text.replace('driver_exe_path = None\n    version_main = None',
                        "driver_exe_path = os.environ.get('FLARESOLVERR_DRIVER_PATH')\n    version_main = None")
    text = text.replace('    if CHROME_EXE_PATH is not None:',
                        "    if os.environ.get('FLARESOLVERR_BROWSER_PATH'):\n        return os.environ['FLARESOLVERR_BROWSER_PATH']\n    if CHROME_EXE_PATH is not None:")
    utils.write_text(text)
    config = json.loads((ROOT / 'state/services.json').read_text())
    config['flaresolverr'] = {'command': [str(venv / 'bin/python'), '-u', str(source / 'src/flaresolverr.py')],
        'cwd': str(source), 'environment': {'HOST': '127.0.0.1', 'PORT': '8191', 'HEADLESS': 'true',
        'TZ': 'Africa/Nairobi', 'LOG_LEVEL': 'info', 'LOG_HTML': 'false',
        'FLARESOLVERR_BROWSER_PATH': str(chrome), 'FLARESOLVERR_DRIVER_PATH': str(driver)}}
    # Preserve authentication and provider settings; only wire the local Solver.
    jackett = ROOT / 'state/jackett/Jackett/ServerConfig.json'
    settings = json.loads(jackett.read_text());settings['FlareSolverrUrl'] = 'http://127.0.0.1:8191'
    save_json(jackett, settings, private=True)
    save_json(ROOT / 'state/services.json', config, private=True)
    save_json(ROOT / 'checks/flaresolverr-install.json', {'version': '3.5.2', 'commit': commit,
        'native_headless_patch': True, 'managed_browser': True, 'bind': '127.0.0.1:8191',
        'dependencies': subprocess.check_output([str(venv / 'bin/python'), '-m', 'pip', 'freeze']).decode().splitlines()})
    print('Native FlareSolverr configured under the existing media supervisor')


def activate_acquisition():
    """Test real providers and enable only those that pass, retaining failures."""
    import urllib.request
    import urllib.error
    import xml.etree.ElementTree as ET
    import re
    result = {'enabled_at': time.time(), 'apps': {}, 'existing_catalog_monitoring_changed': False}
    storage_check(json.loads((ROOT / 'state/storage.json').read_text()))
    for app, port in [('sonarr', 8989), ('radarr', 7878)]:
        key = ET.parse(ROOT / 'state' / app / 'config.xml').findtext('ApiKey')
        def api(path, method='GET', data=None):
            request = urllib.request.Request(f'http://127.0.0.1:{port}/api/v3/' + path, method=method,
                headers={'X-Api-Key': key, 'Content-Type': 'application/json'},
                data=json.dumps(data).encode() if data is not None else None)
            with urllib.request.urlopen(request, timeout=120) as response:
                body = response.read(); return json.loads(body) if body else None
        checks = {'download_clients': [], 'indexers': []}
        for client in api('downloadclient'):
            client['enable'] = True
            api('downloadclient/test', 'POST', client)
            api('downloadclient/' + str(client['id']), 'PUT', client)
            checks['download_clients'].append({'id': client['id'], 'name': client['name'], 'enabled': True, 'test': 'passed'})
        for indexer in api('indexer'):
            indexer.update(enableRss=True, enableAutomaticSearch=True, enableInteractiveSearch=True)
            try:
                api('indexer/test', 'POST', indexer)
                api('indexer/' + str(indexer['id']), 'PUT', indexer)
                entry = {'id': indexer['id'], 'name': indexer['name'], 'enabled': True, 'test': 'passed'}
            except urllib.error.HTTPError as error:
                message = error.read().decode(errors='replace')
                message = re.sub(r'(?i)(apikey[=\\u0026]+)[a-z0-9]+', r'\1REDACTED', message)
                # Details may contain provider credentials; retain them only in private runtime.
                entry = {'id': indexer['id'], 'name': indexer['name'], 'enabled': False, 'test': 'failed', 'detail': message}
                indexer.update(enableRss=False, enableAutomaticSearch=False, enableInteractiveSearch=False)
                api('indexer/' + str(indexer['id']), 'PUT', indexer)
            except (OSError, TimeoutError) as error:
                entry = {'id': indexer['id'], 'name': indexer['name'], 'enabled': False, 'test': 'failed', 'detail': str(error)}
                indexer.update(enableRss=False, enableAutomaticSearch=False, enableInteractiveSearch=False)
                api('indexer/' + str(indexer['id']), 'PUT', indexer)
            checks['indexers'].append(entry)
            print(app + ': ' + entry['name'] + ' ' + entry['test'], flush=True)
            result['apps'][app] = checks
            save_json(ROOT / 'checks/acquisition.json', result, private=True)
        if not any(i['enabled'] for i in checks['indexers']):
            raise RuntimeError(app + ' has no qualified indexer; inspect private acquisition receipt')
    restore_download_preferences()
    ensure_download_import_safety()
    complete_connections()
    result['subtitle_scheduler_enabled'] = True
    result['jellyfin_realtime_monitoring'] = True
    save_json(ROOT / 'checks/acquisition.json', result, private=True)
    save_json(ROOT / 'state/acquisition.json', {'enabled': True, 'enabled_at': time.time()}, private=True)
    print('Qualified acquisition enabled; existing catalog monitoring unchanged')


