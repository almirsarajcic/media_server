        'SlowTorrentsDownloadRate': ('slow_torrent_dl_rate_threshold', 1),
        'SlowTorrentsUploadRate': ('slow_torrent_ul_rate_threshold', 1)}
    values = {}
    for old, (new, factor) in fields.items():
        key = 'Session\\' + old
        if key in config['BitTorrent']:
            value = float(config['BitTorrent'][key]);values[new] = value * factor if new == 'max_ratio' else int(value * factor)
    for old, new in [('QueueingSystemEnabled', 'queueing_enabled'), ('IgnoreSlowTorrentsForQueueing', 'dont_count_slow_torrents'),
                     ('AddTorrentToTopOfQueue', 'add_to_top_of_queue')]:
        if 'Session\\' + old in config['BitTorrent']: values[new] = config.getboolean('BitTorrent', 'Session\\' + old)
    if 'max_ratio' in values: values['max_ratio_enabled'] = values['max_ratio'] >= 0
    if config.has_option('Preferences', 'Bittorrent\\MaxRatioAction'):
        values['max_ratio_act'] = config.getint('Preferences', 'Bittorrent\\MaxRatioAction')
        # Removing a completed torrent can race Arr's completed-download import.
        if values['max_ratio_act'] in (1, 3): values['max_ratio_act'] = 0
    access = json.loads((ROOT / 'state/access.json').read_text())
    opener = urllib.request.build_opener(urllib.request.HTTPCookieProcessor(http.cookiejar.CookieJar()))
    base = 'http://127.0.0.1:8080'
    def post(path, data):
        request = urllib.request.Request(base + path, data=urllib.parse.urlencode(data).encode(), headers={'Referer': base + '/'})
        with opener.open(request, timeout=30) as response: response.read()
    post('/api/v2/auth/login', access)
    before = json.load(opener.open(base + '/api/v2/app/preferences', timeout=30))
    post('/api/v2/app/setPreferences', {'json': json.dumps(values)})
    after = json.load(opener.open(base + '/api/v2/app/preferences', timeout=30))
    if any(after.get(k) != v for k, v in values.items()): raise RuntimeError('Transfer preference readback differs')
    if config.has_option('BitTorrent', 'Session\\UseAlternativeGlobalSpeedLimit'):
        post('/api/v2/transfer/setSpeedLimitsMode', {'mode': int(config.getboolean('BitTorrent', 'Session\\UseAlternativeGlobalSpeedLimit'))})
    save_json(receipt, {'source': str(original), 'applied': values, 'previous': {k: before.get(k) for k in values},
        'native_authentication_and_paths_preserved': True, 'restored_at': time.time()}, private=True)
