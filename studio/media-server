def launchctl(*args, **kwargs):
    prefix = ['sudo', '-n'] if args[0] in ('bootstrap', 'bootout') and args[1].startswith('system') else []
    return subprocess.run(prefix + ['/bin/launchctl', *args], **kwargs)


def health():
