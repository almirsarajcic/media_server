    """Renamed libraries need a scan before Jellyfin resolves their IDs/options."""
    def selected():
        return [library for library in api('/Library/VirtualFolders')
                if any(pathlib.PurePath(path).is_relative_to(ROOT / 'media') for path in library.get('Locations', []))]
    libraries = selected()
    if libraries and all(x.get('ItemId') and x.get('LibraryOptions') is not None for x in libraries):
