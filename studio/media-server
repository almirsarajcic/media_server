def ensure_native_extractor():
    """Bazarr's bundled Mac 'arm64' UnRAR is Intel; use the official ARM build."""
    import tarfile
    archive = ROOT / "installers/unrar-arm-7.23.tar.gz"
    expected = "68b393c000758d477fde43c955ff7542f12f76f3f5e87cdda923152fc791bd4d"
    if not archive.exists():
        subprocess.run(["curl", "--fail", "--location", "--silent", "--show-error", "--retry", "3",
                        "--output", str(archive), "https://www.rarlab.com/rar/rarmacos-arm-723.tar.gz"], check=True)
    if hashlib.file_digest(archive.open("rb"), "sha256").hexdigest() != expected:
        raise RuntimeError("Native archive extractor package checksum mismatch")
    tools = ROOT / "apps/native-tools"
    tools.mkdir(exist_ok=True)
    with tarfile.open(archive, "r:gz") as package:
        content = package.extractfile("rar/unrar").read()
    target = tools / "unrar"
    if not target.exists() or hashlib.sha256(target.read_bytes()).digest() != hashlib.sha256(content).digest():
        target.write_bytes(content); target.chmod(0o755)
    result = subprocess.run([str(target)], capture_output=True, timeout=20)
    if result.returncode:
        raise RuntimeError("Native archive extractor could not execute")
    save_json(ROOT / "checks/native-extractor.json", {"version": "7.23", "architecture": "arm64",
              "source": "https://www.rarlab.com/rar/rarmacos-arm-723.tar.gz", "sha256": expected})


def install_bazarr_requirements(venv, requirements):
    """Use official, hash-checked ARM Python wheels; bounded concurrent downloads."""
    import concurrent.futures
    import math
    import urllib.request
    versions = {"setuptools": "84.0.0", "numpy": "2.3.5", "lxml": "6.1.3",
                "Pillow": "12.3.0", "webrtcvad-wheels": "2.0.14.post1"}
    wheels = ROOT / "installers/wheels"
    wheels.mkdir(exist_ok=True)
    def get_wheel(item):
        name, version = item
        with urllib.request.urlopen("https://pypi.org/pypi/" + name + "/" + version + "/json", timeout=60) as response:
            metadata = json.load(response)
        candidates = [f for f in metadata["urls"] if f["filename"].endswith(".whl") and (
            f["filename"].endswith("py3-none-any.whl") or
            ("-cp313-cp313-" in f["filename"] and "macosx" in f["filename"] and
             ("arm64" in f["filename"] or "universal2" in f["filename"])))]
        if len(candidates) > 1:
            import re
            import platform
            current = tuple(int(p) for p in platform.mac_ver()[0].split(".")[:2])
            def minimum_os(artifact):
                match = re.search(r"macosx_(\d+)_(\d+)", artifact["filename"])
                return tuple(map(int, match.groups())) if match else (0, 0)
            candidates = sorted((f for f in candidates if minimum_os(f) <= current),
                                key=minimum_os, reverse=True)[:1]
        if len(candidates) != 1:
            raise RuntimeError("Expected one matching native Bazarr wheel: " + name)
        artifact = candidates[0]
        dest = wheels / artifact["filename"]
        if dest.exists() and hashlib.file_digest(dest.open("rb"), "sha256").hexdigest() == artifact["digests"]["sha256"]:
            return
        parts = wheels / (artifact["filename"] + ".parts")
        parts.mkdir(exist_ok=True)
        size = artifact["size"]
        count = 8
        chunk = math.ceil(size / count)
        def fetch(i):
            start, end = i * chunk, min(size - 1, (i + 1) * chunk - 1)
            part = parts / str(i)
            if part.exists() and part.stat().st_size == end - start + 1:
                return
            subprocess.run(["curl", "--fail", "--location", "--silent", "--show-error", "--retry", "3",
                            "--connect-timeout", "30", "--range", str(start) + "-" + str(end),
                            "--output", str(part), artifact["url"]], check=True)
            if part.stat().st_size != end - start + 1:
                raise RuntimeError("Wheel server did not honor bounded download range")
        with concurrent.futures.ThreadPoolExecutor(max_workers=count) as pool:
            list(pool.map(fetch, range(count)))
        temp = dest.with_suffix(".assembling")
        with temp.open("wb") as out:
            for i in range(count):
                with (parts / str(i)).open("rb") as source:
                    while block := source.read(1024 * 1024):
                        out.write(block)
        if temp.stat().st_size != size or hashlib.file_digest(temp.open("rb"), "sha256").hexdigest() != artifact["digests"]["sha256"]:
            raise RuntimeError("Native wheel checksum mismatch: " + name)
        temp.rename(dest)
        print("Verified native dependency " + name, flush=True)
    with concurrent.futures.ThreadPoolExecutor(max_workers=3) as pool:
        list(pool.map(get_wheel, versions.items()))
    subprocess.run([str(venv / "bin/pip"), "install", "--no-index", "--find-links", str(wheels),
                    "-r", str(requirements)], check=True)


def verify_retained_torrents(queue, profile):
    """Protect imported records without restricting new, intentionally added work."""
    receipt = json.loads((ROOT / 'checks/config-import.json').read_text())
    hashes = receipt.get('protected_torrent_hashes')
    if hashes is None:
        original = pathlib.Path(profile['mountpoint']) / 'media_server/qbittorrent/qBittorrent/BT_backup'
        hashes = [record.stem.lower() for record in original.glob('*.fastresume')]
    expected = set(hashes)
    if not expected or len(expected) != receipt['paused_torrents']:
        raise RuntimeError('Cannot establish retained torrent identities; inspect the import receipt/source')
    removal = ROOT / 'checks/removed-torrents.json'
    decisions = json.loads(removal.read_text()) if removal.exists() else {}
    removed = set(decisions.get('removed_hashes', []))
    if not removed.issubset(expected):
        raise RuntimeError('Recorded torrent removal includes an unknown original identity')
    readded = set(decisions.get('readded_hashes', []))
    if not readded.issubset(removed):
        raise RuntimeError('Recorded re-download is not a previously removed original identity')
    present = {item['hash'].lower() for item in queue}
    if present & (removed - readded):
        raise RuntimeError('An owner-deleted torrent reappeared without a recorded re-download')
    protected = [item for item in queue if item['hash'].lower() in expected - readded]
    if not (expected - removed).issubset({item['hash'].lower() for item in protected}):
        raise RuntimeError('A protected original torrent is missing from the queue')
    resume_dir = ROOT / 'state/qbittorrent/qBittorrent/data/BT_backup'
    for item in protected:
        if not item['state'].lower().startswith(('stopped', 'paused', 'missingfiles')):
            raise RuntimeError('A protected original torrent is no longer stopped')
        resume = bdecode((resume_dir / (item['hash'].lower() + '.fastresume')).read_bytes())
        if resume.get(b'paused') != 1 or resume.get(b'auto_managed') != 0:
            raise RuntimeError('A protected original torrent is not durably stopped')
        if item.get('dlspeed') or item.get('upspeed'):
            raise RuntimeError('A protected original torrent is unexpectedly transferring data')
    return protected


def verify_services():
