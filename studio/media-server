def register_external(uuid, mountpoint, media_root):
    """Explicit migration step, never formatting, copying, or guessing a disk."""
    if not uuid or not mountpoint or not media_root:
        raise RuntimeError("External registration requires UUID, mountpoint and existing media root")
    active = launchctl("print", job_domain() + "/" + LABEL, capture_output=True)
    if not active.returncode:
        state = json.loads((ROOT / 'state/status.json').read_text())
        if not (ROOT / 'state/maintenance').exists() or state.get('phase') != 'maintenance' or state.get('apps') or time.time() - state.get('checked_at', 0) > 10:
            raise RuntimeError("Stop the media supervisor before changing storage")
    info = disk_info(uuid)
    if str(info.get("VolumeUUID", "")).upper() != uuid.upper() or info.get("Internal", True):
        raise RuntimeError("Configured UUID is not the intended external volume")
    if not info.get("MountPoint"):
        result = subprocess.run(["/usr/sbin/diskutil", "mount", info["DeviceIdentifier"]], capture_output=True, timeout=25)
        if result.returncode:
            raise RuntimeError("External volume cannot be mounted")
        info = disk_info(uuid)
    if info.get("MountPoint") != mountpoint or not info.get("WritableVolume", False):
        raise RuntimeError("External volume mount or writable status does not match")
    media = pathlib.Path(media_root).resolve()
    volume = pathlib.Path(mountpoint).resolve()
    if not media.is_relative_to(volume):
        raise RuntimeError("External media folder is outside the selected volume")
    for name in ("movies", "tv", "downloads"):
        if not (media / name).is_dir() or (media / name).stat().st_dev != volume.stat().st_dev:
            raise RuntimeError("External media directories must already exist on the selected volume")
    import secrets
    marker_file = media / ".media-server-storage"
    marker = marker_file.read_text().strip() if marker_file.exists() else secrets.token_hex(16)
    if not marker:
        raise RuntimeError("External media marker is empty")
    marker_file.write_text(marker + "\n")
    profile = {"mode": "external", "volume_uuid": uuid, "mountpoint": mountpoint,
               "media_root": str(media), "marker": marker}
    stable = ROOT / "media"
    if stable.exists() or stable.is_symlink():
        raise RuntimeError("Media path already exists; review the registered profile before replacing it")
    try:
        stable.symlink_to(media, target_is_directory=True)
        storage_check(profile)
        save_json(ROOT / "state/storage.json", profile)
    except Exception:
        if stable.is_symlink(): stable.unlink()
        raise
    print("External volume registered. Run check, then start.")


def stop_supervisor():
    state_dir = ROOT / 'state'
    state_dir.mkdir(parents=True, exist_ok=True)
    client_lock = (state_dir / 'control-client.lock').open('a')
    os.fchmod(client_lock.fileno(), 0o600)
    try:
        try:
            fcntl.flock(client_lock.fileno(), fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError as error:
            raise RuntimeError('A media control command is active; retry maintenance after it completes') from error
        guard = operation_guard()
        if guard is None:
            raise RuntimeError('A backup or media lifecycle operation is active; no maintenance hold was written')
        try:
            current = load_lifecycle().get('operation')
            if current and current.get('status') == 'pending':
                raise RuntimeError('A media lifecycle operation is active; no maintenance hold was written')
            if (state_dir / 'control-request.json').exists() or (state_dir / 'control-inflight.json').exists():
                raise RuntimeError('A media control request is pending; no maintenance hold was written')
            (state_dir / 'maintenance').touch(mode=0o600)
            deadline = time.monotonic() + 45
            while time.monotonic() < deadline:
                status_path = state_dir / 'status.json'
                state = json.loads(status_path.read_text()) if status_path.exists() else {}
                if state.get('phase') == 'maintenance' and not state.get('apps') and time.time() - state.get('checked_at', 0) < 10:
                    print('All media processes stopped; boot supervisor retains durable maintenance hold')
                    return
                time.sleep(0.5)
            raise RuntimeError('System supervisor has not confirmed maintenance stop')
        finally:
            release_operation_guard(guard)
    finally:
        fcntl.flock(client_lock.fileno(), fcntl.LOCK_UN)
        client_lock.close()


