                        db.execute('update '+tq+' set '+cq+'=replace('+cq+',?,?) where instr('+cq+',?)>0',('/data/',media+'/', '/data/'))
            result['bazarr'] = 'provider settings and database imported; automatic tasks remain off'
        # Existing Jackett seed is already qualified; refresh provider records
