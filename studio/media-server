def _test_recovery():
    profile_path = ROOT / 'state/storage.json'
    original = json.loads(profile_path.read_text())
    state_path = ROOT / 'state/status.json'
    before = json.loads(state_path.read_text())
    if original['mode'] != 'external' or before.get('phase') != 'running':
        raise RuntimeError('Recovery test requires the healthy external stack')
    save_json(ROOT / 'checks/storage-profile-before-recovery.json', original, private=True)
    blocked = False
    try:
        save_json(profile_path, {**original, 'volume_uuid': '00000000-0000-0000-0000-000000000000'})
        deadline = time.monotonic() + 75
        while time.monotonic() < deadline:
            state = json.loads(state_path.read_text())
            if state.get('phase') == 'blocked' and not state.get('apps'):
                open_ports = []
                for port in [80, *MDNS_PORTS.values(), *([8191] if 'flaresolverr' in before['apps'] else [])]:
                    try:
                        with socket.create_connection(('127.0.0.1', port), timeout=0.5): open_ports.append(port)
                    except OSError: pass
                if open_ports: raise RuntimeError('Ports remained open after storage loss: ' + str(open_ports))
                blocked = True
                break
            time.sleep(2)
        if not blocked: raise RuntimeError('Storage gate did not stop the stack')
    finally:
        save_json(profile_path, original)
    deadline = time.monotonic() + 150
    while time.monotonic() < deadline:
        after = json.loads(state_path.read_text())
        if after.get('phase') == 'running' and len(after.get('apps', {})) == len(before['apps']) and len(after.get('mdns', {})) == 6 and after.get('proxy'):
            if any(after['apps'][n] == pid for n, pid in before['apps'].items()):
                raise RuntimeError('An app PID was not replaced during recovery')
            save_json(ROOT / 'checks/external-recovery.json', {'blocked_wrong_uuid': blocked, 'all_ports_closed': True,
                      'apps_recovered': len(after['apps']), 'proxy_and_aliases_recovered': True, 'job_domain': job_domain(),
                      'physical_disconnect': False, 'checked_at': time.time()})
            print('External UUID gate stopped all media ports and recovered all apps, proxy and aliases')
            return
        time.sleep(2)
    raise RuntimeError('Real profile restored, but healthy recovery timed out; inspect status/logs')


def prepare_boot():
    """Prepare a bounded administrator handoff; never run media apps as root."""
    import pwd
    import shlex
    user = pwd.getpwuid(os.getuid()).pw_name
    services = json.loads((ROOT / 'state/services.json').read_text())
    if 'qbittorrent-nox' not in services['qbittorrent']['command'][0]:
        raise RuntimeError('Install and select headless qBittorrent first')
    job = startup_job()
    job['UserName'] = user
    job['GroupName'] = 'staff'
    job['Umask'] = 0o077
    prepared = ROOT / 'state' / (LABEL + '.boot.plist')
    prepared.write_bytes(plistlib.dumps(job))
    q = shlex.quote
    # This script only installs the prepared plist. The supervisor always runs
    # as UserName. No user-writable Python is executed with administrator rights.
    body = '\n'.join([
        '#!/bin/sh', 'set -eu',
        'test "$(id -u)" = 0 || { echo "Run with sudo"; exit 1; }',
        '/usr/bin/plutil -lint ' + q(str(prepared)),
        'if /bin/launchctl print ' + q(DOMAIN + '/' + LABEL) + ' >/dev/null 2>&1; then',
        '  echo "Stop the media login supervisor before installing boot startup"; exit 1', 'fi',
        '/usr/bin/install -o root -g wheel -m 644 ' + q(str(prepared)) + ' ' + q(str(DAEMON_PLIST)),
        'if test -f ' + q(str(PLIST)) + '; then /bin/rm ' + q(str(PLIST)) + '; fi',
        'if ! /bin/launchctl print ' + q('system/' + LABEL) + ' >/dev/null 2>&1; then',
        '  /bin/launchctl bootstrap system ' + q(str(DAEMON_PLIST)), 'fi',
        '/bin/launchctl print ' + q('system/' + LABEL), ''])
    target = ROOT / 'install-boot.sh'
    target.write_text(body); target.chmod(0o700)
    (ROOT / 'state/maintenance').touch(mode=0o600)
    print('Administrator installation: sudo /bin/sh ' + q(str(target)))


def save_json(path, value, private=False):
    path.parent.mkdir(parents=True, exist_ok=True)
    temp = path.with_suffix(path.suffix + ".new")
    temp.write_text(json.dumps(value, indent=2))
    temp.chmod(0o600 if private else 0o644)
    temp.replace(path)


def disk_info(identifier):
    result = subprocess.run(
        ["/usr/sbin/diskutil", "info", "-plist", str(identifier)],
        capture_output=True, timeout=12,
    )
    if result.returncode:
        raise RuntimeError("Expected media volume is unavailable")
    return plistlib.loads(result.stdout)


def storage_check(profile, mount=False):
    """Never accept an ordinary folder in place of the configured volume."""
    if profile.get("mode") != "external":
        raise RuntimeError("A registered external storage profile is required")
    uuid = profile.get("volume_uuid")
    if not uuid:
        raise RuntimeError("Expected media volume UUID is not configured")
    expected_mount = pathlib.Path(profile["mountpoint"])
    info = disk_info(uuid)
    if str(info.get("VolumeUUID", "")).upper() != uuid.upper():
        raise RuntimeError("Media volume UUID does not match")
    if profile["mode"] == "external" and info.get("Internal", True):
        raise RuntimeError("External storage profile resolved to an internal volume")
    if not info.get("MountPoint") and mount and profile["mode"] == "external":
        result = subprocess.run(
            ["/usr/sbin/diskutil", "mount", info["DeviceIdentifier"]],
            capture_output=True, timeout=25,
        )
        if result.returncode:
            raise RuntimeError("Expected media volume could not be mounted")
        info = disk_info(uuid)
    if str(info.get("VolumeUUID", "")).upper() != uuid.upper():
        raise RuntimeError("Media volume UUID does not match")
    if info.get("MountPoint") != str(expected_mount):
        raise RuntimeError("Expected media volume is not mounted at its configured location")
    if not info.get("WritableVolume", False):
        raise RuntimeError("Expected media volume is read-only")
    bounded_storage_paths_check(profile)
    return info


def storage_paths_check(profile):
    """Filesystem checks run only in the disposable probe process."""
    expected_mount = pathlib.Path(profile["mountpoint"])
    device = expected_mount.stat().st_dev
    media = pathlib.Path(profile["media_root"])
    if profile["mode"] == "external" and not media.resolve().is_relative_to(expected_mount.resolve()):
        raise RuntimeError("Media root is outside the verified volume")
    if profile["mode"] == "external" and (ROOT / "media").resolve() != media.resolve():
        raise RuntimeError("Stable application media path does not point to the verified external root")
    marker = media / ".media-server-storage"
    if not marker.is_file() or marker.read_text().strip() != profile["marker"]:
        raise RuntimeError("Media storage marker is missing or does not match")
    for name in ("movies", "tv", "downloads"):
        directory = media / name
        if not directory.is_dir() or directory.stat().st_dev != device:
            raise RuntimeError("Required media directory is missing or on a different volume: " + name)
        if not directory.resolve().is_relative_to(media.resolve()):
            raise RuntimeError("Media directory points outside the verified media root")
        if not os.access(directory, os.W_OK):
            raise RuntimeError("Required media directory is not writable: " + name)


_STORAGE_PROBE = None
_STORAGE_PROBE_TIMEOUT = 8.0
_STORAGE_PROBE_CODE = """
import json, pathlib, runpy, sys
controller = runpy.run_path(sys.argv[1])
request = json.load(sys.stdin)
controller['storage_paths_check'].__globals__['ROOT'] = pathlib.Path(request['root'])
try:
    controller['storage_paths_check'](request['profile'])
except (OSError, RuntimeError, ValueError) as error:
    print(json.dumps({'error': str(error)}))
    raise SystemExit(1)
print('{}')
"""


def bounded_storage_paths_check(profile):
    """Keep a stalled external open from freezing lifecycle/status updates.

    At most one probe may remain in kernel I/O. A timed-out probe is killed,
    but the supervisor never waits indefinitely for that kill to complete.
    Storage remains blocked until a later full verification succeeds.
    """
    global _STORAGE_PROBE
    if _STORAGE_PROBE is not None:
        if _STORAGE_PROBE.poll() is None:
            raise RuntimeError('Media filesystem verification is still blocked')
        _STORAGE_PROBE = None
    process = subprocess.Popen(
        [sys.executable, '-I', '-c', _STORAGE_PROBE_CODE, str(pathlib.Path(__file__).resolve())],
        stdin=subprocess.PIPE, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL,
        start_new_session=True, close_fds=True,
    )
    _STORAGE_PROBE = process
    try:
        output, _ = process.communicate(
            json.dumps({'root': str(ROOT), 'profile': profile}).encode(),
            timeout=_STORAGE_PROBE_TIMEOUT,
        )
    except subprocess.TimeoutExpired:
        with contextlib.suppress(ProcessLookupError):
            process.kill()
        try:
            process.communicate(timeout=0.2)
        except subprocess.TimeoutExpired:
            pass
        raise RuntimeError('Media filesystem verification timed out') from None
    finally:
        if process.poll() is not None:
            _STORAGE_PROBE = None
    if len(output) > 4096:
        raise RuntimeError('Media filesystem verification returned invalid output')
    try:
        result = json.loads(output)
    except (ValueError, UnicodeError):
        raise RuntimeError('Media filesystem verification failed') from None
    if process.returncode or result != {}:
        raise RuntimeError(result.get('error', 'Media filesystem verification failed')
                           if isinstance(result, dict) else 'Media filesystem verification failed')


def stop_children(children):
    """Only our own process groups; no dependence on a removed media volume."""
    for process, _ in children.values():
        if process.poll() is None:
            with contextlib.suppress(ProcessLookupError):
                os.killpg(process.pid, signal.SIGTERM)
    deadline = time.monotonic() + 20
    while any(p.poll() is None for p, _ in children.values()) and time.monotonic() < deadline:
        time.sleep(0.2)
    for process, _ in children.values():
        # A live Popen child has not been reaped, so its PID cannot have been reused.
        if process.poll() is None:
            with contextlib.suppress(ProcessLookupError):
                os.killpg(process.pid, signal.SIGKILL)
        with contextlib.suppress(subprocess.TimeoutExpired):
            process.wait(timeout=2)
    children.clear()


def process_group_exists(pgid):
    try:
        os.killpg(pgid, 0)
        return True
    except ProcessLookupError:
        return False
    except PermissionError:
        return True


def graceful_signal(name):
    """Use the installed app's normal shutdown signal; Bazarr handles SIGINT."""
    return signal.SIGINT if name == 'bazarr' else signal.SIGTERM


