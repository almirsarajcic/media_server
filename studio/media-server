    elif args.command == 'control':
        if not args.service or not args.action:
            result = {'ok': False, 'status': 'blocked', 'service': args.service,
                      'action': args.action, 'message': 'Control requires --service and --action.'}
            print(json.dumps(result, separators=(',', ':')))
            raise SystemExit(2)
        result, exit_code = control_command(args.service, args.action, args.timeout)
        print(json.dumps(result, separators=(',', ':')))
        if exit_code:
            raise SystemExit(exit_code)
    elif args.command == "status":
        path = ROOT / "state/status.json"
        state = json.loads(path.read_text()) if path.exists() else {'phase': 'not_started'}
        try:
            lifecycle = load_lifecycle()
            configured = set(json.loads((ROOT / 'state/services.json').read_text()))
            state['services'] = lifecycle_service_status(
                configured, {name: (type('StatusProcess', (), {'pid': pid})(), None)
                             for name, pid in state.get('apps', {}).items()},
                state.get('endpoints', {}), lifecycle, {})
            state['intentional_stops'] = sorted(
                set(lifecycle.get('service_stops', [])) | set(lifecycle.get('media_stops', [])))
            state['control_operation'] = lifecycle.get('operation') or lifecycle.get('last_result')
        except (OSError, ValueError, RuntimeError):
            pass
        state['job_loaded'] = launchctl('print', job_domain() + '/' + LABEL, capture_output=True).returncode == 0
        state['job_domain'] = job_domain()
        if state.get('phase') in ('running', 'degraded', 'maintenance', 'blocked') and (not state['job_loaded'] or time.time() - state.get('checked_at', 0) > 90):
            state['phase'] = 'stale'
        print(json.dumps(state, indent=2))
    elif args.command == "storage":
        register_external(args.uuid, args.mountpoint, args.media_root)
    elif args.command == "verify":
