def bdecode(data):
    offset = 0
    def read():
        nonlocal offset
        prefix = data[offset:offset+1];offset += 1
        if prefix == b'i':
            end=data.index(b'e',offset);value=int(data[offset:end]);offset=end+1;return value
        if prefix in (b'l',b'd'):
            values=[]
            while data[offset:offset+1] != b'e': values.append(read())
            offset += 1
            return dict(zip(values[::2],values[1::2])) if prefix==b'd' else values
        offset-=1;end=data.index(b':',offset);length=int(data[offset:end]);offset=end+1
        value=data[offset:offset+length];offset+=length;return value
    result=read()
    if offset != len(data): raise ValueError('Trailing bencode data')
    return result


def bencode(value):
    if isinstance(value,int): return b'i'+str(value).encode()+b'e'
    if isinstance(value,bytes): return str(len(value)).encode()+b':'+value
    if isinstance(value,list): return b'l'+b''.join(bencode(x) for x in value)+b'e'
    if isinstance(value,dict): return b'd'+b''.join(bencode(k)+bencode(value[k]) for k in sorted(value))+b'e'
    raise TypeError(type(value))


